# OpenCharterApp environment variables (spec §7, D-219). Every variable the app reads, with
# placeholder values only. For local development copy this file to .env.local (git-ignored) and
# fill in your own project's values. Deployed Workers get the public values from wrangler.jsonc
# (`vars`, per environment) and the secrets from the Worker's settings, never from a file.
#
# Anything starting with VITE_ is built into the browser bundle and is PUBLIC.

# --- Supabase project (public) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# The same values for server functions (read at run time on the Worker).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# --- Suite settings (public; spec §1.1, §4.1) ---
# false (default) = self-hosted: the app's own landing, sign-in and org screens.
# true = hosted under OpenAppHub: sign-in, orgs and billing in the hub.
VITE_HOSTED=false
VITE_APP_ID=charter
VITE_APP_SCHEMA=charter
# Hosted only. The hub's address, the parent domain for the shared session cookie, and the
# other apps' addresses for the suite switcher (JSON: app id → URL).
VITE_HUB_URL=
VITE_COOKIE_DOMAIN=
VITE_SUITE_URLS=
# Where Help links point (default https://docs.openapphub.org).
VITE_DOCS_URL=https://docs.openapphub.org

# --- Server-only (Worker vars) ---
# The app's public address (e.g. https://members.example.org) for links that leave the app and
# come back, such as the return from Stripe Checkout. When unset, the browser's address (Origin /
# Referer header) is used, never the server's internal URL (D-158).
PUBLIC_APP_URL=
# Extra origins checkout may return to (comma-separated).
PUBLIC_APP_ALLOWED_ORIGINS=

# --- Server-only SECRETS (Worker secrets; never commit real values) ---
# Service-role key: only for dues payment completion, failure and refund recording (spec §7.2).
SUPABASE_SERVICE_ROLE_KEY=
# Encrypts each organization's own Stripe keys for member dues (32 random bytes, base64).
# Generate with: openssl rand -base64 32
GATEWAY_ENCRYPTION_KEY=

# --- Planned (D-159): how email is sent. "smtp" = the client's own mail server, configured in
# the app on Settings → Email. Unset = no email. ---
EMAIL_TRANSPORT=

# --- Local testing only ---
# Postgres server where scripts/db-test.sh may create and drop its own test database.
# Never point this at a real project database.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# The demo accounts' password for the smoke and end-to-end tests (no default, D-218).
SMOKE_DEMO_PASSWORD=
