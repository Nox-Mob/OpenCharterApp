# OpenCharterApp environment variables. Copy to .env.local for local overrides.
# The committed .env (managed by Lovable) holds only the publishable values below.

# --- Lovable Cloud / Supabase project (publishable, safe in the browser) ---
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Server-only secrets (set as Lovable Cloud secrets; never commit real values) ---
# Service-role key used by server functions that act on behalf of the system.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret that authorizes scheduled (cron) server routes; the previous value is accepted during rotation.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
# E-12: key that encrypts each organization's Stripe credentials (32 random bytes, base64).
# Generate with: openssl rand -base64 32
GATEWAY_ENCRYPTION_KEY=

# E-08 (planned, D-159): how email is sent. "lovable" = Lovable Cloud's email; "smtp" = the
# client's own mail server, configured in the app on Settings → Email. Unset = no email.
EMAIL_TRANSPORT=

# Optional: the app's public address (e.g. https://members.example.org) for links that leave the
# app and come back, such as the return from Stripe Checkout. When unset, the browser's address
# (Origin / Referer header) is used, never the server's internal URL (D-158).
PUBLIC_APP_URL=

# --- Local testing only ---
# Postgres server where scripts/db-test.sh may create and drop its own test database.
# Never point this at the real project database.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
